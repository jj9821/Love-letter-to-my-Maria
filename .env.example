# Supabase Configuration
# Required: Your Supabase Project URL (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Required for server-side analytics ingestion & admin reporting (Keep this secret! Never expose to client)
# Found in Project Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Optional: Supabase Anon Key (for any client-side Supabase features, if used)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Admin Analytics Dashboard Passcode
# Set a secure passcode to protect /admin/analytics dashboard from public access
ADMIN_ANALYTICS_PASSWORD=secret_admin_passcode_here
